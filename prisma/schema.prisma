generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  // Auth
  email                String    @unique
  google_id            String?

  // Profil Onboarding
  nama_lengkap         String?
  universitas          String?
  jenjang              String?   // s1 | s2 | s3
  jurusan              String?
  semester             Int?
  punya_judul          Boolean?  @default(false)
  judul_skripsi        String?   // NULL jika belum
  preferred_ai         String?   // claude | chatgpt | perplexity
  onboarding_completed Boolean?  @default(false)

  // Payment & Tier
  tier                 String    @default("spark")  // spark | drive | summit
  payment_ref          String?
  paid_at              DateTime? @db.Timestamptz
  expired_at           DateTime? @db.Timestamptz    // NULL = lifetime

  // Bimbingan (Summit)
  sessions_total       Int?      @default(0)
  sessions_used        Int?      @default(0)

  // Afiliasi
  affiliate_code       String?   @unique
  referred_by          String?   // affiliate_code dari referrer

  // Timestamps
  created_at           DateTime? @default(now()) @db.Timestamptz
  updated_at           DateTime? @default(now()) @db.Timestamptz

  // Relations
  documents            Document[]
  references           Reference[]
  comments             Comment[]

  @@map("users")
}

model ChecklistProgress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  bab         Int       // 1–5
  item_id     String
  checked     Boolean?  @default(false)
  updated_at  DateTime? @default(now()) @db.Timestamptz

  @@unique([user_id, bab, item_id])
  @@map("checklist_progress")
}

model BabProgress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  bab         Int       // 1–5
  percentage  Int?      @default(0)              // 0–100
  updated_at  DateTime? @default(now()) @db.Timestamptz

  @@unique([user_id, bab])
  @@map("bab_progress")
}

model Commission {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliate_code  String
  buyer_email     String
  product_tier    String
  amount          Decimal?  @db.Decimal
  commission      Decimal?  @db.Decimal
  rate            Decimal?  @db.Decimal           // 0.30 atau 0.50
  status          String?   @default("pending") // pending | paid
  created_at      DateTime? @default(now()) @db.Timestamptz

  @@map("commissions")
}

model WebhookLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source      String?   // lynkid
  payload     Json?
  status      String?
  processed   Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz

  @@map("webhook_logs")
}

model Document {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  title       String    @default("Untitled Document")
  type        String    @default("skripsi") // skripsi | tesis | disertasi
  target_date DateTime? @db.Timestamptz
  created_at  DateTime? @default(now()) @db.Timestamptz
  updated_at  DateTime? @default(now()) @db.Timestamptz

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  outlines    Outline[]
  references  Reference[]
  citations   Citation[]
  timelines   Timeline[]
  comments    Comment[]

  @@map("documents")
}

model Outline {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String    @db.Uuid
  title       String
  order       Int       @default(0)
  content     String?   // Tiptap JSON or HTML
  parent_id   String?   @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz
  updated_at  DateTime? @default(now()) @db.Timestamptz

  document    Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  parent      Outline?  @relation("OutlineToOutline", fields: [parent_id], references: [id], onDelete: Cascade)
  children    Outline[] @relation("OutlineToOutline")

  @@map("outlines")
}

model Reference {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid // Shared across user's documents
  document_id String?   @db.Uuid // If tied to a specific doc
  type        String    // journal | book | website
  authors     Json?     // Array of authors
  year        String?
  title       String
  source      String?   // Journal name, publisher, etc.
  doi_url     String?
  created_at  DateTime? @default(now()) @db.Timestamptz

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [document_id], references: [id], onDelete: SetNull)
  citations   Citation[]

  @@map("references")
}

model Citation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String    @db.Uuid
  reference_id String   @db.Uuid
  position    String?   // Location in text
  format      String?   // e.g. "(Smith, 2023)"
  created_at  DateTime? @default(now()) @db.Timestamptz

  document    Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  reference   Reference @relation(fields: [reference_id], references: [id], onDelete: Cascade)

  @@map("citations")
}

model Timeline {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String    @db.Uuid
  start_date  DateTime? @db.Timestamptz
  target_date DateTime? @db.Timestamptz
  status      String?   @default("active") // active | completed | paused
  created_at  DateTime? @default(now()) @db.Timestamptz
  updated_at  DateTime? @default(now()) @db.Timestamptz

  document    Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  milestones  Milestone[]

  @@map("timelines")
}

model Milestone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timeline_id String    @db.Uuid
  title       String
  type        String?   @default("custom") // bab | custom
  target_date DateTime? @db.Timestamptz
  completed_at DateTime? @db.Timestamptz
  status      String?   @default("pending") // pending | in_progress | completed | overdue
  order       Int       @default(0)

  timeline    Timeline  @relation(fields: [timeline_id], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model Comment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_id String    @db.Uuid
  author_id   String    @db.Uuid // Can be student or supervisor
  content     String
  quote       String?   // The highlighted text
  position    Json?     // { from: number, to: number }
  type        String?   @default("suggestion") // revision | suggestion | question
  status      String?   @default("open") // open | resolved
  parent_id   String?   @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz
  updated_at  DateTime? @default(now()) @db.Timestamptz

  document    Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [author_id], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentToComment", fields: [parent_id], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentToComment")

  @@map("comments")
}
